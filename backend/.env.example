NODE_ENV=development
PORT=3000
# PostgreSQL locally; use TLS and a private network in production.
DATABASE_URL=postgresql://tazekal:local-development-only@localhost:15432/tazekal
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=15432
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# Comma-separated WEB OAuth client IDs accepted by the API. Empty disables Google login.
GOOGLE_CLIENT_IDS=
# Optional trusted browser origins. Mobile requests do not need CORS.
CORS_ORIGINS=http://localhost:3000
