# Copy to .env.production. Generate TWO separate values using:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Use URL-safe characters for the database password (the command above does).
POSTGRES_PASSWORD=replace-with-a-generated-url-safe-password
JWT_SECRET=replace-with-a-separate-generated-secret
API_PORT=3000
# Accepted WEB OAuth client IDs, same Google project as the Android client.
GOOGLE_CLIENT_IDS=
CORS_ORIGINS=
